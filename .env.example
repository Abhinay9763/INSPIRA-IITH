# Environment Variables for AI Interview Preparation Platform - Stage 2
# Copy this to .env and fill in your actual values

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here

# Optional: Override default models (uncomment if needed)
# INTERVIEWER_MODEL=llama-3.1-8b-instant
# QUESTION_GEN_MODEL=llama-3.3-70b-versatile
# DEBRIEF_MODEL=llama-3.3-70b-versatile

# Optional: Override default TTS voice
# TTS_VOICE=en-US-GuyNeural

# Optional: Override API configuration
# API_HOST=0.0.0.0
# API_PORT=8000